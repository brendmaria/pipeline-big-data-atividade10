# Origem dos dados brutos (somente leitura)
MONGO_URI=mongodb://usuario:senha@host:27017/
MONGO_DB=iot_agricola

# MariaDB (Série limpa e agregados)
MARIADB_HOST=localhost
MARIADB_PORT=3306
MARIADB_USER=usuario
MARIADB_PASSWORD=senha
MARIADB_DATABASE=iot_agricola

# Redis (Cache de último valor)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=senha

# Prefixo obrigatório da aluna
PREFIXO=brenda